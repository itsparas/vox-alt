# VoxReception Environment Configuration
# Copy this file and rename to .env, then fill in your API keys

# ============================================================
# AI SERVICE API KEYS
# ============================================================

# OpenAI API Key (Required for LLM/AI responses)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Deepgram API Key (Required for Speech-to-Text)
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ElevenLabs API Key (Required for Text-to-Speech)
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ============================================================
# OPTIONAL: Stripe (for billing - not required for dev)
# ============================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
